H388X_PASSWORD=your_admin_password_here
# Modem host: IP, hostname, or full URL with scheme.
# Examples:
#   H388X_HOST=192.168.1.1
#   H388X_HOST=modem.example.com
#   H388X_HOST=https://modem.example.com:8443
# Plain hostnames default to http://. For backward compatibility the CLI
# still reads H388X_IP if H388X_HOST is unset.
H388X_HOST=192.168.1.1
H388X_USER=admin
